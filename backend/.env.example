APP_NAME=ChargeTrackr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=changetrackr
DB_USERNAME=changetrackr
DB_PASSWORD=
DB_TIMEZONE=UTC

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@chargetrackr.local"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
DEMO_REQUEST_NOTIFICATION_EMAIL=
ACCOUNT_INVITATION_EXPIRATION_HOURS=48
EMPLOYEE_INVITATION_EXPIRATION_HOURS=72
EMPLOYEE_INVITATION_REMINDER_COOLDOWN_MINUTES=10
DEMO_TRIAL_DAYS=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

PAYMENT_DRIVER=wiremock
PAYMENT_PREAUTHORIZATION_AMOUNT_MILLIMES=30000
PAYMENT_AUTHORIZATION_TTL_MINUTES=15
PAYMENT_SIMULATOR_BASE_URL=http://127.0.0.1:9090
PAYMENT_SIMULATOR_OPERATION_ENDPOINT=/v1/payment-operations
PAYMENT_SIMULATOR_API_KEY=chargetrackr-local
PAYMENT_SIMULATOR_WEBHOOK_URL=http://host.docker.internal:8000/api/internal/payments/webhooks
PAYMENT_SIMULATOR_WEBHOOK_SECRET=local-payment-webhook-secret
PAYMENT_SIMULATOR_TIMEOUT_SECONDS=3
PAYMENT_SIMULATOR_RETRIES=0
CHARGING_PRICE_PER_KWH_MILLIMES=850
CHARGING_SESSION_FEE_MILLIMES=500

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/oauth/google/callback"

OCPP_GATEWAY_SHARED_SECRET=
OCPP_GATEWAY_SIGNATURE_TOLERANCE_SECONDS=300
OCPP_COMMAND_TTL_SECONDS=120
OCPP_SUPERVISION_COMMAND_TTL_SECONDS=60
OCPP_COMMAND_POLL_INTERVAL_SECONDS=1.5
OCPP_SIMULATOR_STATION_SECRET=
OCPP_SIMULATOR_ID_TAG=TEST-TAG-001

AVAILABILITY_HEARTBEAT_INTERVAL_SECONDS=30
AVAILABILITY_COMMUNICATION_TIMEOUT_SECONDS=90
AVAILABILITY_CRITICAL_ALERT_DUE_MINUTES=15
