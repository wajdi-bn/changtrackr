{
  "name": "charge-trackr",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:frontend": "pnpm --dir frontend dev",
    "build:frontend": "pnpm --dir frontend build",
    "lint:frontend": "pnpm --dir frontend lint",
    "test:frontend": "pnpm --dir frontend test",
    "preview:frontend": "pnpm --dir frontend preview",
    "dev:backend": "cd backend && C:/php/php.exe artisan serve --host=0.0.0.0 --port=8000",
    "dev:backend:ocpp": "cd backend && C:/php/php.exe artisan serve --host=0.0.0.0 --port=8000",
    "dev:queue": "cd backend && C:/php/php.exe artisan queue:work redis --queue=payments,broadcasts,emails,maintenance,default --sleep=1 --tries=3 --timeout=90",
    "dev:queue:payments": "cd backend && C:/php/php.exe artisan queue:work redis --queue=payments --sleep=1 --tries=3 --timeout=90",
    "dev:queue:broadcasts": "cd backend && C:/php/php.exe artisan queue:work redis --queue=broadcasts --sleep=1 --tries=3 --timeout=90",
    "dev:queue:emails": "cd backend && C:/php/php.exe artisan queue:work redis --queue=emails --sleep=1 --tries=3 --timeout=90",
    "dev:queue:maintenance": "cd backend && C:/php/php.exe artisan queue:work redis --queue=maintenance,default --sleep=1 --tries=3 --timeout=90",
    "dev:scheduler": "cd backend && C:/php/php.exe artisan schedule:work",
    "dev:reverb": "cd backend && C:/php/php.exe artisan reverb:start --host=0.0.0.0 --port=8080",
    "migrate:backend": "cd backend && C:/php/php.exe artisan migrate",
    "test:backend": "cd backend && C:/php/php.exe artisan test",
    "infra:configure": "powershell -ExecutionPolicy Bypass -File scripts/configure-infra-env.ps1",
    "infra:configure:redis": "powershell -ExecutionPolicy Bypass -File scripts/configure-infra-env.ps1 -SyncRedisDrivers",
    "infra:up": "docker compose --env-file infra/.env -f infra/docker-compose.yml up -d",
    "infra:up:redis": "docker compose --env-file infra/.env -f infra/docker-compose.yml up -d redis",
    "infra:down": "docker compose --env-file infra/.env -f infra/docker-compose.yml down",
    "infra:status": "docker compose --env-file infra/.env -f infra/docker-compose.yml ps",
    "test:infra-config": "node --test infra/docker-compose.test.mjs",
    "ocpp:configure": "powershell -ExecutionPolicy Bypass -File scripts/configure-ocpp-env.ps1",
    "ocpp:provision-fleet": "powershell -ExecutionPolicy Bypass -File scripts/provision-ocpp-simulator-fleet.ps1",
    "ocpp:add-simulator-station": "cd backend && C:/php/php.exe artisan ocpp:register-simulator-station",
    "ocpp:up": "node scripts/start-ocpp.mjs",
    "ocpp:down": "docker compose --env-file infra/ocpp/.env -f infra/ocpp/compose.yaml down",
    "ocpp:scenario": "node scripts/ocpp-control.mjs scenario",
    "ocpp:transaction-scenario": "node scripts/ocpp-control.mjs transaction-scenario",
    "ocpp:stop-transaction": "node scripts/ocpp-control.mjs stop-transaction",
    "ocpp:plug": "node scripts/ocpp-control.mjs plug",
    "ocpp:unplug": "node scripts/ocpp-control.mjs unplug",
    "ocpp:connect": "node scripts/ocpp-control.mjs connect",
    "ocpp:disconnect": "node scripts/ocpp-control.mjs disconnect",
    "ocpp:status": "node scripts/ocpp-control.mjs status",
    "ocpp:fleet-status": "node scripts/ocpp-control.mjs fleet-status",
    "payment:up": "docker compose -f infra/payment-simulator/compose.yaml up -d",
    "payment:down": "docker compose -f infra/payment-simulator/compose.yaml down",
    "payment:status": "docker compose -f infra/payment-simulator/compose.yaml ps",
    "payment:logs": "docker compose -f infra/payment-simulator/compose.yaml logs -f payment-simulator",
    "payment:reset": "curl.exe -X POST http://127.0.0.1:9090/__admin/requests/reset",
    "test:ocpp-tools": "node --test infra/ocpp/simulator/read-station-state.test.mjs",
    "test:ocpp-gateway": "docker build --target test -t chargetrackr-ocpp-gateway-test ocpp-gateway && docker run --rm chargetrackr-ocpp-gateway-test"
  },
  "engines": {
    "node": ">=22"
  }
}
