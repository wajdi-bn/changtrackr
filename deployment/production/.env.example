# Public endpoints
APP_DOMAIN=chargetrackr.me
API_DOMAIN=api.chargetrackr.me
REALTIME_DOMAIN=realtime.chargetrackr.me
OCPP_DOMAIN=ocpp.chargetrackr.me
ACME_EMAIL=replace-with-your-email@example.com

# Published image set
GHCR_OWNER=wajdi-bn
IMAGE_TAG=latest

# Laravel runtime
APP_NAME=ChargeTrackr
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.chargetrackr.me
FRONTEND_URL=https://chargetrackr.me
TRUSTED_PROXIES=*
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
STATION_METRICS_TIMEZONE=Africa/Tunis
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# Stateful browser authentication
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.chargetrackr.me
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=chargetrackr.me,www.chargetrackr.me
CORS_ALLOWED_ORIGINS=https://chargetrackr.me,https://www.chargetrackr.me

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=changetrackr
DB_USERNAME=changetrackr
DB_PASSWORD=
DB_TIMEZONE=UTC
POSTGRES_DB=changetrackr
POSTGRES_USER=changetrackr
POSTGRES_PASSWORD=

# Redis cache, sessions and queues
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
CACHE_STORE=redis
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=cache
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120
REDIS_QUEUE_BLOCK_FOR=5
QUEUE_PAYMENTS=payments
QUEUE_BROADCASTS=broadcasts
QUEUE_EMAILS=emails
QUEUE_MAINTENANCE=maintenance

# Resend: set the verified-domain API key locally, never in GitHub
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=no-reply@chargetrackr.me
MAIL_FROM_NAME=ChargeTrackr
RESEND_API_KEY=
DEMO_REQUEST_NOTIFICATION_EMAIL=wajdi.benabdeljelil@etudiant-fst.utm.tn

# Google OAuth: add the production callback in Google Cloud first
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.chargetrackr.me/auth/oauth/google/callback

# Reverb. The application key is public; the secret must remain private.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=chargetrackr-production
REVERB_APP_KEY=chargetrackr-production
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://chargetrackr.me,https://www.chargetrackr.me

# External payment simulator
PAYMENT_DRIVER=wiremock
PAYMENT_PREAUTHORIZATION_AMOUNT_MILLIMES=30000
PAYMENT_AUTHORIZATION_TTL_MINUTES=15
PAYMENT_SIMULATOR_BASE_URL=http://payment-simulator:8080
PAYMENT_SIMULATOR_OPERATION_ENDPOINT=/v1/payment-operations
PAYMENT_SIMULATOR_API_KEY=
PAYMENT_SIMULATOR_WEBHOOK_URL=http://backend/api/internal/payments/webhooks
PAYMENT_SIMULATOR_WEBHOOK_SECRET=
PAYMENT_SIMULATOR_TIMEOUT_SECONDS=3
PAYMENT_SIMULATOR_RETRIES=0
CHARGING_PRICE_PER_KWH_MILLIMES=850
CHARGING_SESSION_FEE_MILLIMES=500
CHARGING_IDLE_GRACE_SECONDS=300

# OCPP gateway and local simulation lab
OCPP_ENVIRONMENT=production
OCPP_GATEWAY_HOST=0.0.0.0
OCPP_GATEWAY_PORT=9000
OCPP_GATEWAY_PATH_PREFIX=/ocpp
OCPP_GATEWAY_TLS_MODE=proxy
OCPP_GATEWAY_PUBLIC_URL=wss://ocpp.chargetrackr.me/ocpp
OCPP_LARAVEL_BASE_URL=https://api.chargetrackr.me/api/internal/ocpp
OCPP_GATEWAY_SHARED_SECRET=
OCPP_SIMULATOR_STATION_SECRET=
OCPP_SIMULATOR_UI_PASSWORD=
OCPP_SIMULATOR_CONTROL_URL=http://ocpp-simulator-control:8081
OCPP_SIMULATOR_CONTROL_TOKEN=
OCPP_SIMULATOR_ID_TAG=TEST-TAG-001
OCPP_HEARTBEAT_INTERVAL_SECONDS=30
OCPP_COMMAND_POLL_INTERVAL_SECONDS=1.5

# Availability projection
AVAILABILITY_HEARTBEAT_INTERVAL_SECONDS=30
AVAILABILITY_COMMUNICATION_TIMEOUT_SECONDS=90
AVAILABILITY_DASHBOARD_CACHE_TTL_SECONDS=60
AVAILABILITY_CRITICAL_ALERT_DUE_MINUTES=15

# Azure backup target provisioned by deployment/azure/provision.ps1
AZURE_BACKUP_STORAGE_ACCOUNT=
AZURE_BACKUP_CONTAINER=backups
BACKUP_RETENTION_DAYS=7
