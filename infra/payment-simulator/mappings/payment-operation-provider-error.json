{
  "id": "01456952-53ed-44a3-b3c1-80ab64769522",
  "name": "Payment provider service unavailable",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/payment-operations",
    "headers": {
      "X-Simulator-Api-Key": {
        "equalTo": "chargetrackr-local"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.simulation_outcome == 'provider_error')]"
      }
    ]
  },
  "response": {
    "status": 503,
    "headers": {
      "Content-Type": "application/json",
      "Retry-After": "1"
    },
    "jsonBody": {
      "status": "unavailable",
      "error": {
        "code": "provider_unavailable",
        "message": "The simulated payment provider is temporarily unavailable."
      }
    }
  }
}
